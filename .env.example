# Email / SMTP configuration (for split payment one-click pay links)
# Get these from your email provider (Gmail, SendGrid, Mailgun, Zoho, etc.)
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Optional: override the "from" address (defaults to SMTP_USER)
SMTP_FROM=Turf Buddie <your-email@gmail.com>

# Public app URL (used to build payment links in emails)
NEXT_PUBLIC_APP_URL=https://your-domain.com
